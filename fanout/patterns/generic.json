{
  "rules": [
    {
      "id": "gen-job",
      "re": "context.length|context_length_exceeded|prompt is too long|\\b413\\b|\\b422\\b|error_max_turns|max.turns",
      "outcome": "job_error"
    },
    {
      "id": "gen-429",
      "re": "\\b429\\b|rate.?limit|too many requests",
      "outcome": "rate_limited"
    },
    {
      "id": "gen-quota",
      "re": "quota|usage limit|exhausted your|RESOURCE_EXHAUSTED",
      "outcome": "quota_exhausted"
    },
    {
      "id": "gen-credits",
      "re": "insufficient (account )?(funds|credits?)|\\bcredits? (exhausted|balance|limit)|out of credits|\\b402\\b|payment required",
      "outcome": "credits_exhausted",
      "scope": "account"
    },
    {
      "id": "gen-auth",
      "re": "\\b401\\b|\\b403\\b|unauthorized|not logged in|auth_unavailable|invalid api key",
      "outcome": "auth_error"
    },
    {
      "id": "gen-model",
      "re": "model .* (not found|is not recognized|unavailable|deprecated)|invalid model",
      "outcome": "model_unavailable"
    },
    {
      "id": "gen-overload",
      "re": "overloaded|model_concurrency|\\b503\\b",
      "outcome": "rate_limited",
      "cooldownS": 30
    },
    {
      "id": "gen-worker",
      "re": "context canceled|worker crashed|segmentation fault",
      "outcome": "worker_error"
    }
  ]
}
