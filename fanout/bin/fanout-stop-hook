#!/usr/bin/env bash
set -euo pipefail
# Empty-context guard only: the hook is keyed to the session, so a session
# started in $HOME still owes its report. Fail open: never block the session.
[ -n "$CLAUDE_PROJECT_DIR" ] || exit 0
REAL="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$REAL")"
if command -v bun >/dev/null 2>&1; then
  BUN="$(command -v bun)"
elif [ -x "$HOME/.bun/bin/bun" ]; then
  BUN="$HOME/.bun/bin/bun"
else
  exit 0
fi
if [ -f "$ROOT/fanout.js" ]; then
  exec "$BUN" "$ROOT/fanout.js" hook stop || exit 0
else
  exec "$BUN" "$ROOT/../src/cli.ts" hook stop || exit 0
fi
